# Database
DATABASE_URL=postgresql://postgres:postgres_65@localhost:5432/lebid

# JWT
JWT_SECRET_KEY=your-very-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — frontend origin (update when frontend is running)
CORS_ORIGINS=http://localhost:5173

# AI (Gemini)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL=gemini-1.5-flash

# App
APP_ENV=development

# Key used to encrypt secrets stored in the database (Gemini API keys).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret, back it up, and NEVER change it later.
ENCRYPTION_KEY=

